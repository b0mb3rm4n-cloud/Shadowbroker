# Shadowbroker ↔ StrikeRadar Pro — fusion v1 environment template.
# Copy to .env.fusion and edit. .env.fusion is git-ignored.

# ── Existing Shadowbroker keys (carry over from your normal .env) ──────
ADMIN_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
AIS_API_KEY=
FINNHUB_API_KEY=

# ── StrikeRadar Pro keys (separate accounts from SB ones) ──────────────
# OpenSky has both a "client_id/secret" (SB) and a "username/password"
# (legacy SR signal API) — set whichever your SR build uses.
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENWEATHER_API_KEY=

# Optional: SR risk-history Postgres. Empty = SR will use local JSON in
# the strikeradar_data volume, which is fine for local fusion runs.
SR_DATABASE_URL=

# ── Cross-service auth (optional hardening) ────────────────────────────
# If set, SB's Next.js proxy adds X-API-Key to every /api/strikeradar/*
# call. SR has matching SHADOWBROKER_API_KEY support if you want both
# directions authenticated.
STRIKERADAR_API_KEY=
SHADOWBROKER_API_KEY=
# Per-request timeout SR uses when calling SB endpoints. Default 20s
# because SB's /api/health and /api/live-data/fast can take 5-15s when
# SB is mid-cycle (it ingests ~17 live sources). Drop to 8s only if you
# have a particularly lightweight SB deployment.
SHADOWBROKER_TIMEOUT_S=20.0

# ── Bind / port overrides ──────────────────────────────────────────────
# Set BIND=0.0.0.0 to expose services to the LAN (default 127.0.0.1).
BIND=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
STRIKERADAR_PORT=8080
